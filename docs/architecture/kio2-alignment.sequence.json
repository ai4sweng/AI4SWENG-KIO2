    {
      "from": 290,
      "to": 388,
      "label": "2. Turn each run into steps, then align"
    },
    {
      "from": 398,
      "to": 526,
      "label": "3. Answer"
    }
  ],
  "messages": [
    {
      "id": "m-submit",
      "from": "kio1",
      "to": "api",
      "y": 200,
