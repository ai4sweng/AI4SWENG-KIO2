    {
      "id": "m-poll",
      "from": "kio1",
      "to": "api",
      "y": 478,
      "label": "GET /jobs/{job_id}",
      "variant": "default"
    },
    {
      "id": "m-final",
      "from": "api",
      "to": "kio1",
      "y": 510,
      "label": "success, comparison",
      "variant": "return"
