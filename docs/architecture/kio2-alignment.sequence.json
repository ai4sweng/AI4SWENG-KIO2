  "cards": [
    {
      "dot": "cyan",
      "title": "How it aligns",
      "items": [
        "Each run becomes a list of executed steps, one per function:line",
        "The lists are aligned like DNA sequences (Needleman-Wunsch)"
      ]
    },
    {
      "dot": "emerald",
      "title": "Out",
      "items": [
        "Two traces: distance (unmatched steps) and where they diverge",
        "Three or more: distance matrix, typical run, most different run"
      ]
    },
    {
      "dot": "slate",
      "title": "Good to know",
      "items": [
        "Meant for one program run with different inputs",
        "Lines are matched by number, not by their source text"
      ]
    }
  ]
